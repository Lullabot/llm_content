<?php

/**
 * @file
 * Install, update, and uninstall functions for the LLM Content module.
 */

declare(strict_types=1);

/**
 * Implements hook_requirements().
 */
function llm_content_requirements(string $phase): array {
  $requirements = [];
  if ($phase === 'install') {
    if (!class_exists('League\HTMLToMarkdown\HtmlConverter')) {
      $requirements['llm_content_html_to_markdown'] = [
        'title' => t('LLM Content - HTML to Markdown library'),
        'description' => t('The league/html-to-markdown library is required. Run <code>composer require league/html-to-markdown:^5.0</code> in your project root.'),
        'severity' => REQUIREMENT_ERROR,
      ];
    }
  }
  return $requirements;
}

/**
 * Implements hook_schema().
 */
function llm_content_schema(): array {
  $schema['llm_content_markdown'] = [
    'description' => 'Stores generated markdown for nodes.',
    'fields' => [
      'nid' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'The node ID.',
      ],
      'langcode' => [
        'type' => 'varchar',
        'length' => 12,
        'not null' => TRUE,
        'default' => '',
        'description' => 'The language code.',
      ],
      'markdown' => [
        'type' => 'text',
        'size' => 'big',
        'not null' => TRUE,
        'description' => 'The generated markdown.',
      ],
      'generated' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Unix timestamp of generation.',
      ],
    ],
    'primary key' => ['nid', 'langcode'],
    'indexes' => [
      'generated' => ['generated'],
    ],
  ];
  return $schema;
}

/**
 * Implements hook_install().
 */
function llm_content_install(): void {
  _llm_content_queue_missing_nodes();
  _llm_content_sync_xmlsitemap_if_enabled();
}

/**
 * Syncs LLM content links into xmlsitemap when integration is enabled.
 *
 * Runs at install and from update hooks so sites that import config with
 * xmlsitemap_integration already TRUE backfill existing nodes, matching
 * the behavior of toggling the setting through the UI.
 */
function _llm_content_sync_xmlsitemap_if_enabled(): void {
  /** @var \Drupal\llm_content\Service\XmlSitemapLinkManagerInterface $manager */
  $manager = \Drupal::service('Drupal\llm_content\Service\XmlSitemapLinkManagerInterface');
  if (!$manager->isEnabled()) {
    return;
  }
  $manager->syncAllLinks();
  \Drupal::logger('llm_content')->notice('Synced LLM content links into xmlsitemap.');
}

/**
 * Queues published nodes that don't yet have generated markdown.
 */
function _llm_content_queue_missing_nodes(): void {
  $config = \Drupal::config('llm_content.settings');
  $types = $config->get('enabled_content_types') ?: [];
  if (empty($types)) {
    return;
  }

  /** @var \Drupal\llm_content\Service\MarkdownConverterInterface $converter */
  $converter = \Drupal::service('Drupal\llm_content\Service\MarkdownConverterInterface');
  $nids = $converter->getNidsMissingMarkdown($types);

  if (empty($nids)) {
    return;
  }

  $queue = \Drupal::queue('llm_content_markdown_generation');
  foreach ($nids as $nid) {
    $queue->createItem(['nid' => (int) $nid]);
  }

  \Drupal::logger('llm_content')->notice('Queued @count nodes for markdown generation.', [
    '@count' => count($nids),
  ]);
}

/**
 * Add xmlsitemap integration config defaults.
 */
function llm_content_update_11001(): void {
  $config = \Drupal::configFactory()->getEditable('llm_content.settings');
  $defaults = [
    'xmlsitemap_integration' => FALSE,
    'xmlsitemap_priority' => '0.5',
    'xmlsitemap_changefreq' => 604800,
    'xmlsitemap_index_priority' => '0.7',
    'disable_builtin_sitemap' => FALSE,
  ];
  foreach ($defaults as $key => $value) {
    if ($config->get($key) === NULL) {
      $config->set($key, $value);
    }
  }
  $config->save();
}

/**
 * Backfill xmlsitemap links for existing nodes when integration is enabled.
 *
 * Sites that imported config with xmlsitemap_integration: true never
 * triggered the settings form submit handler, so the link table was empty
 * even though the standalone /sitemap-llm.xml worked. This populates it.
 */
function llm_content_update_11002(): void {
  _llm_content_sync_xmlsitemap_if_enabled();
}
