<?php

/**
 * @file
 * Install, update, and uninstall functions for the LLM Content module.
 */

declare(strict_types=1);

use Drupal\Core\Cache\Cache;
use Drupal\llm_content\Service\XmlSitemapLinkManagerInterface;

/**
 * Implements hook_requirements().
 */
function llm_content_requirements(string $phase): array {
  $requirements = [];
  if ($phase === 'install') {
    if (!class_exists('League\HTMLToMarkdown\HtmlConverter')) {
      $requirements['llm_content_html_to_markdown'] = [
        'title' => t('LLM Content - HTML to Markdown library'),
        'description' => t('The league/html-to-markdown library is required. Run <code>composer require league/html-to-markdown:^5.0</code> in your project root.'),
        'severity' => REQUIREMENT_ERROR,
      ];
    }
  }
  return $requirements;
}

/**
 * Implements hook_schema().
 */
function llm_content_schema(): array {
  $schema['llm_content_markdown'] = [
    'description' => 'Stores generated markdown for nodes.',
    'fields' => [
      'nid' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'The node ID.',
      ],
      'langcode' => [
        'type' => 'varchar',
        'length' => 12,
        'not null' => TRUE,
        'default' => '',
        'description' => 'The language code.',
      ],
      'markdown' => [
        'type' => 'text',
        'size' => 'big',
        'not null' => TRUE,
        'description' => 'The generated markdown.',
      ],
      'generated' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Unix timestamp of generation.',
      ],
    ],
    'primary key' => ['nid', 'langcode'],
    'indexes' => [
      'generated' => ['generated'],
    ],
  ];
  return $schema;
}

/**
 * Implements hook_install().
 */
function llm_content_install(): void {
  _llm_content_queue_missing_nodes();
  _llm_content_sync_xmlsitemap_if_enabled();
}

/**
 * Syncs LLM content links into xmlsitemap when integration is enabled.
 *
 * Runs at install and from update hooks so sites that import config with
 * xmlsitemap_integration already TRUE backfill existing nodes, matching
 * the behavior of toggling the setting through the UI.
 *
 * The install-hook call only fires when xmlsitemap_integration is already
 * TRUE at install time. Sites whose config import flips it from FALSE to
 * TRUE *after* module install will not trigger here — they rely on
 * llm_content_update_11002 or `drush llm:sitemap-sync` to backfill.
 *
 * Note: syncAllLinks() runs in 100-row batches inside a single request.
 * On very large datasets (~50k+ nodes) the update hook could exceed PHP
 * time limits; operators should run `drush llm:sitemap-sync` manually in
 * that case rather than relying on `drush updb`.
 */
function _llm_content_sync_xmlsitemap_if_enabled(): void {
  /** @var \Drupal\llm_content\Service\XmlSitemapLinkManagerInterface $manager */
  $manager = \Drupal::service(XmlSitemapLinkManagerInterface::class);
  if (!$manager->isEnabled()) {
    return;
  }
  $count = $manager->syncAllLinks();
  \Drupal::logger('llm_content')->notice('Synced @count LLM content links into xmlsitemap.', [
    '@count' => $count,
  ]);
}

/**
 * Queues published nodes that don't yet have generated markdown.
 */
function _llm_content_queue_missing_nodes(): void {
  $config = \Drupal::config('llm_content.settings');
  $types = $config->get('enabled_content_types') ?: [];
  if (empty($types)) {
    return;
  }

  /** @var \Drupal\llm_content\Service\MarkdownConverterInterface $converter */
  $converter = \Drupal::service('Drupal\llm_content\Service\MarkdownConverterInterface');
  $nids = $converter->getNidsMissingMarkdown($types);

  if (empty($nids)) {
    return;
  }

  $queue = \Drupal::queue('llm_content_markdown_generation');
  foreach ($nids as $nid) {
    $queue->createItem(['nid' => (int) $nid]);
  }

  \Drupal::logger('llm_content')->notice('Queued @count nodes for markdown generation.', [
    '@count' => count($nids),
  ]);
}

/**
 * Add xmlsitemap integration config defaults.
 */
function llm_content_update_11001(): void {
  $config = \Drupal::configFactory()->getEditable('llm_content.settings');
  $defaults = [
    'xmlsitemap_integration' => FALSE,
    'xmlsitemap_priority' => '0.5',
    'xmlsitemap_changefreq' => 604800,
    'xmlsitemap_index_priority' => '0.7',
    'disable_builtin_sitemap' => FALSE,
  ];
  foreach ($defaults as $key => $value) {
    if ($config->get($key) === NULL) {
      $config->set($key, $value);
    }
  }
  $config->save();
}

/**
 * Backfill xmlsitemap links for existing nodes when integration is enabled.
 *
 * Sites that imported config with xmlsitemap_integration: true never
 * triggered the settings form submit handler, so the link table was empty
 * even though the standalone /sitemap-llm.xml worked. This populates it.
 */
function llm_content_update_11002(): void {
  _llm_content_sync_xmlsitemap_if_enabled();
}

/**
 * Purge and regenerate stored markdown rendered under privileged accounts.
 *
 * Before the AccountSwitcher fix, convert() rendered each node in the
 * request context of whoever triggered the save. The result is stored
 * keyed only on (nid, langcode) — no privilege dimension — and served to
 * anonymous visitors through /llms-full.txt, so any row generated by a
 * privileged user could contain content that user alone could see.
 *
 * Fixing the render path is not sufficient: existing rows already carry
 * whatever privilege level happened to write them.
 *
 * Each pass takes a chunk of stored rows, queues each one for
 * regeneration under the anonymous account, and deletes it. Working from
 * the stored rows rather than from a node query matters on multilingual
 * sites: a node query returns default-language nids only, so translation
 * rows would be destroyed with nothing to rebuild them. Batching matters
 * because the purge must not be able to half-finish — an unbatched
 * truncate on a large site can empty the table and then time out.
 *
 * Cached per-node markdown is invalidated alongside each row. Those
 * responses carry only a node:N tag, so invalidating llm_content:list
 * alone would leave /node/N/llm-md serving the pre-fix body.
 *
 * @param array $sandbox
 *   The batch context.
 */
function llm_content_update_11003(array &$sandbox): string {
  $database = \Drupal::database();

  if (!isset($sandbox['max'])) {
    $sandbox['max'] = (int) $database->select('llm_content_markdown', 'm')
      ->countQuery()
      ->execute()
      ->fetchField();
    $sandbox['progress'] = 0;
  }

  if ($sandbox['max'] === 0) {
    $sandbox['#finished'] = 1;
    Cache::invalidateTags(['llm_content:list']);
    return 'No stored markdown to purge.';
  }

  $rows = $database->select('llm_content_markdown', 'm')
    ->fields('m', ['nid', 'langcode'])
    ->orderBy('m.nid')
    ->orderBy('m.langcode')
    ->range(0, 100)
    ->execute()
    ->fetchAll();

  $queue = \Drupal::queue('llm_content_markdown_generation');
  $tags = [];
  foreach ($rows as $row) {
    $queue->createItem([
      'nid' => (int) $row->nid,
      'langcode' => $row->langcode,
    ]);
    $database->delete('llm_content_markdown')
      ->condition('nid', $row->nid)
      ->condition('langcode', $row->langcode)
      ->execute();
    $tags[] = 'node:' . $row->nid;
    $sandbox['progress']++;
  }

  if ($tags !== []) {
    Cache::invalidateTags(array_unique($tags));
  }

  // Rows are deleted as they are queued, so an empty pass means done.
  $sandbox['#finished'] = $rows === []
    ? 1
    : min(0.99, $sandbox['progress'] / $sandbox['max']);

  if ($sandbox['#finished'] >= 1) {
    Cache::invalidateTags(['llm_content:list']);
    return sprintf(
      'Purged %d stored markdown rows and queued them for regeneration. Until the queue drains, /llms.txt and /llms-full.txt are incomplete — cron drains it for 60 seconds per run, or run `drush queue:run llm_content_markdown_generation` to finish now.',
      $sandbox['progress'],
    );
  }

  return sprintf('Purged and queued %d of %d rows.', $sandbox['progress'], $sandbox['max']);
}
